# --- Application ---
API_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+psycopg://credit_user:credit_pass@localhost:5432/credit_risk_db

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
SCORE_CACHE_TTL_SECONDS=300

# --- Model artifacts ---
MODEL_ARTIFACT_DIR=./artifacts
TGAT_MODEL_FILENAME=tgat_embedder.pt
XGB_MODEL_FILENAME=xgb_scorer.json

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=credit-risk-scoring

# --- Training ---
RANDOM_SEED=42
SYNTHETIC_N_BUSINESSES=4000